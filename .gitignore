# credentials and live config — never commit
iceberg-conformance/.secrets/
iceberg-conformance/catalogs.yaml
iceberg-conformance/.warehouse/

# run artefacts: evidence contains account ids, bucket names and workspace GUIDs
iceberg-conformance/evidence/
iceberg-conformance/out/

# sprint submission material — contains personal details
# Any sprint submission row: these carry a real name, email and country.
# Pattern rather than exact names -- sprint-row-paper1.* was not covered
# by the two literal entries that used to be here.
sprint-row*
gen_rows.py
PROJECT-IDEAS.md
*.pdf

# working copy of the paper; the published copy lives in papers/
article-draft.md

__pycache__/
*.pyc
iceberg-agent/__pycache__/
# Azure SDK writes a developer-tools device id into a path built from
# LOCALAPPDATA; unset on Linux, so it lands in a directory literally named None
iceberg-agent/None/
**/.cache/Microsoft/
